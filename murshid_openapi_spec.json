  "paths": {
    "/rpc/auto_confirm_test_user": {
      "post": {
        "summary": "Auto-confirm test email accounts",
        "description": "PostgreSQL security definer function to instantly confirm automated test accounts during signups.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_email": {
                    "type": "string",
                    "format": "email",
                    "example": "automated-test-flow@test.com"
                  }
                },
                "required": ["user_email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test account confirmed successfully."
          },
          "400": {
            "description": "Invalid email or database error."
          }
        }
      }
    },
    "/courses": {
      "get": {
        "summary": "Get engineering courses list",
        "description": "Retrieves the full list of engineering academic courses from the database.",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of courses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sections": {
      "get": {
        "summary": "Get course sections list",
        "description": "Retrieves the class sections and time schedules for courses.",
        "responses": {
          "200": {
            "description": "Successful retrieval of sections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Section"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/maintenance_mode": {
      "get": {
        "summary": "Check Maintenance Mode state",
        "description": "Queries the database to check if global maintenance mode is enabled.",
        "responses": {
          "200": {
            "description": "Successful retrieval.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MaintenanceMode"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upsert Maintenance Mode state",
        "description": "Updates or inserts the global maintenance state (Admin only).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintenanceMode"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully upserted."
          }
        }
      }
    },
    "/user_schedules": {
      "post": {
        "summary": "Upsert student schedule",
        "description": "Saves or updates a generated class schedule for the student.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": { "type": "string" },
                  "schedule_data": { "type": "object" },
                  "created_at": { "type": "string", "format": "date-time" }
                },
                "required": ["user_id", "schedule_data"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Schedule upserted successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
