{
  "openapi": "3.0.3",
  "info": {
    "title": "Hadeed / Murshid Supabase REST API",
    "description": "Auto-generated OpenAPI specification for Murshid Engineering Hub Supabase backend endpoints including tables and RPC functions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://www.hadeed.shop/rest/v1",
      "description": "Production Supabase REST Gateway"
    }
